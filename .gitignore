*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Unity Editor crash-recovery autosaves (not real project content)
/Assets/_Recovery/
/Assets/_Recovery.meta

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

